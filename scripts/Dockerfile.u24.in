# Purpose: Creates the container for running the cctReviewBackend software
#          in a Ubuntu container.
# Usage: podman build -t cctreviewbackend:latest -f Dockerfile.u24
#        buildah bud -t cctreviewbackend:latest -f Dockerfile.u24
FROM ubuntu:24.04

# Numeric, because Kubernetes cannot verify runAsNonRoot against a user
# name - it refuses to start the container rather than guess.  Override at
# build time if the cluster pins a different range.
ARG RUN_UID=10001
ARG RUN_GID=10001

COPY @PROJECT_NAME@-@PROJECT_VERSION@-Linux.tar.gz .
LABEL version="@PROJECT_VERSION@"
# The binary's only non-libc shared dependencies (readelf -d NEEDED) are
# libcurl and libpq; everything else is linked statically.  apt pulls in
# their own dependencies - OpenSSL, LDAP, zstd, krb5, nghttp2, etc.
RUN apt-get update &&\
    apt-get upgrade -y &&\
    apt-get -y install --no-install-recommends \
            bash \
            ca-certificates \
            libcurl4t64 \
            libpq5 &&\
    groupadd --system --gid ${RUN_GID} cctreview &&\ 
    useradd --system --uid ${RUN_UID} --gid ${RUN_GID} \
            --no-create-home --home-dir /nonexistent \
            --shell /usr/sbin/nologin cctreview &&\ 
    tar -xf ./@PROJECT_NAME@-@PROJECT_VERSION@-Linux.tar.gz &&\ 
    mv ./@PROJECT_NAME@-@PROJECT_VERSION@-Linux/bin/cctReviewBackend /usr/local/bin &&\ 
    rm -r ./@PROJECT_NAME@-@PROJECT_VERSION@-Linux/ &&\ 
    apt-get autoremove -y &&\
    apt-get clean &&\
    rm -r /var/lib/apt/lists/* ./@PROJECT_NAME@-@PROJECT_VERSION@-Linux.tar.gz

# The binary and its config are read, never written.  Nothing in the image
# is owned by the run user, so the container runs happily with
# readOnlyRootFilesystem: true.
USER ${RUN_UID}:${RUN_GID}

# Documentation only - neither podman nor Kubernetes binds anything from
# this.  What the process actually listens on is the port input into
# the application.  Unprivileged either way, so no NET_BIND_SERVICE is
# needed.
EXPOSE 8000

# CMD and no ENTRYPOINT, so a pod spec supplying command+args replaces this
# outright.  With an ENTRYPOINT, an args-only override would be appended to
# the binary instead of replacing it, and it would receive the shell script
# as its argv.
CMD ["/usr/local/bin/cctReviewBackend", "--ini=/config/config.ini"]

